!outputs/cv_metrics.json
!outputs/test_predictions.npz
models/training_history.npz
models/cv/

# Streamlit cache
.streamlit/

# IDE
.vscode/
.idea/

# Web frontend (build with: cd web && npm install && npm run build)
web/node_modules/
web/dist/
